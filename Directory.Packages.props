<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitiveVersionPinningEnabled>true</CentralPackageTransitiveVersionPinningEnabled>
	</PropertyGroup>

	<!-- Version of NUnit and NSubstitute used depends on the target framework -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net35'
			OR '$(TargetFramework)'=='netcoreapp2.1' OR '$(TargetFramework)'=='netcoreapp3.1'
		    OR '$(TargetFramework)'=='net5.0' Or '$(TargetFramework)'=='net5.0-windows'" >
		<NUnitVersion>3.14.0</NUnitVersion>
		<NSubstituteVersion>2.0.3</NSubstituteVersion>
	</PropertyGroup>

	<!-- Default versions for targets not listed above -->
	<PropertyGroup>
		<NUnitVersion Condition="'$(NUnitVersion)'==''">4.4.0</NUnitVersion>
		<NSubstituteVersion Condition="'$(NSubstituteVersion)'==''">6.2.0</NSubstituteVersion>
	</PropertyGroup>

	<ItemGroup>
	    <PackageVersion Include="CSharpIsNullAnalyzer" Version="0.2.19" />
		<PackageVersion Include="IsExternalInit" Version="1.0.3" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />
        <PackageVersion Include="NSubstitute" Version="$(NSubstituteVersion)" />
		<PackageVersion Include="Nullable" Version="1.3.1" />
		<PackageVersion Include="NUnit" Version="$(NUnitVersion)" />
		<PackageVersion Include="NUnitLite" Version="$(NUnitVersion)" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
        <PackageVersion Include="NUnit.Agent.Core" Version="4.0.0-beta.5.9" />
		<PackageVersion Include="NUnit.Common" Version="4.0.0-beta.4.10" />
		<PackageVersion Include="NUnit.Engine" Version="4.0.0-beta.4.10" />
        <PackageVersion Include="NUnit.Engine.Api" Version="4.0.0-beta.8.12" />
        <PackageVersion Include="NUnit.Extensibility" Version="4.0.0-beta.4.8" />
        <PackageVersion Include="NUnit.Extensibility.Api" Version="4.0.0-beta.4.8" />
        <PackageVersion Include="NUnit.Extension.Net462PluggableAgent" Version="4.1.3-beta.1.2" />
        <PackageVersion Include="NUnit.Extension.Net80PluggableAgent" Version="4.1.4-beta.1.1" />
        <PackageVersion Include="NUnit.Extension.Net90PluggableAgent" Version="4.1.3-beta.1.1" />
        <PackageVersion Include="NUnit.Extension.Net10PluggableAgent" Version="4.0.0-beta.2.1" />
        <PackageVersion Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556" />
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
        <PackageVersion Include="TestCentric.Metadata" Version="3.0.4" />
		<PackageVersion Include="TunnelVisionLabs.ReferenceAssemblyAnnotator" Version="1.0.0-alpha.160" />
        <PackageVersion Include="XmlUnit.NUnit4.Constraints" Version="2.11.2" />
	</ItemGroup>

</Project>
 